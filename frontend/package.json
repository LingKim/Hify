    "remark-gfm": "^4.0.1",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "6.0.1",
    "jsdom": "29.1.1",
    "oxfmt": "0.47.0",
